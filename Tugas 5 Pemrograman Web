<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Github Finder</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
</head>

<body>
    <!-- Container -->
    <main class="container" style="max-width: 500px; margin-top: 50px;">
        <h3>🔍 Pencarian Profil Github</h3>

        <!-- Form Input -->
        <form id="formcari">
            <fieldset rol="group">
                <input type="text" id="user" placeholder="Ketik Username..." required>
                <button type="Submit">Cari</button>
            </fieldset>
        </form>

        <!--Tempat Status (Loading/error)-->
        <p id="status" style="font-weight: bold; text-align: center;"></p>

        <!--Tempat Hasil(Awalnya Disembunyikan)-->
        <article id="hasil" style="display: none; text-align: center;">
            <img id="foto" style="margin-bottom: 100px; border-radius: 50%; border: 2px solid var(--pico-primary);"
                alt="Foto Profil">
            <h3 id="nama" style="margin-bottom: 0;"></h3>
            <p id="bio" style="font-size: 0.9em; color: gray;"></p>

            <mark id="repository"></mark> Repository publik

            <br><br>
            <a id="link" target="_blank" role="button">Kunjungi Profil Github
            </a>
        </article>
    </main>

    <script>
        document.getElementById('formcari').addEventListener('submit', async function (e) {
            e.preventDefault(); // Mencegah Halaman Reload Saat Form Disubmit

            const userInput = document.getElementById('user').value.trim();
            const status = document.getElementById('status');
            const hasil = document.getElementById('hasil');

            // Tampilkan Loading
            hasil.style.display = 'none';
            status.innerText = '⏳ Sedang Mencari...';
            status.style.color = 'blue';

            try {
                // Fetch API
                const res = await fetch(`https://api.github.com/users/${userInput}`);

                // Cek Error
                if (!res.ok) {
                    const data = await res.json();
                    throw new Error(data.message === 'Not Found' ? '❌ Pengguna Tidak Ditemukan!' : `❌ Terjadi Kesalahan: ${data.message}`);
                }

                const data = await res.json();

                // Tampilkan Data jika Sukses
                status.innerText = "";
                hasil.style.display = 'block';

                document.getElementById('foto').src = data.avatar_url;
                document.getElementById('nama').innerText = data.name || data.login || 'Tanpa Nama';
                document.getElementById('bio').innerText = data.bio || 'Tidak ada bio.';
                document.getElementById('repository').innerText = data.public_repos || 0;
                document.getElementById('link').href = data.html_url;

            } catch (err) {
                // Tangani Error
                status.innerText = err.message;
                status.style.color = 'red';
                hasil.style.display = 'none';
            }
        });
    </script>
</body>

</html>
